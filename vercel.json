{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "okay-dev-vanilla/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://devengers-api.onrender.com/api/$1"
    },
    { "src": "/login",           "dest": "/okay-dev-vanilla/login.html" },
    { "src": "/register",        "dest": "/okay-dev-vanilla/register.html" },
    { "src": "/forgot-password", "dest": "/okay-dev-vanilla/forgot-password.html" },
    { "src": "/reset-password",  "dest": "/okay-dev-vanilla/forgot-password.html" },
    { "src": "/profile",         "dest": "/okay-dev-vanilla/profile.html" },
    { "src": "/events",          "dest": "/okay-dev-vanilla/events.html" },
    { "src": "/campus",          "dest": "/okay-dev-vanilla/campus.html" },
    { "src": "/dsa",             "dest": "/okay-dev-vanilla/dsa.html" },
    { "src": "/learn",           "dest": "/okay-dev-vanilla/learn.html" },
    { "src": "/certificates",    "dest": "/okay-dev-vanilla/certificates.html" },
    { "src": "/jobs",            "dest": "/okay-dev-vanilla/jobs.html" },
    { "src": "/gallery",         "dest": "/okay-dev-vanilla/gallery.html" },
    { "src": "/directory",       "dest": "/okay-dev-vanilla/directory.html" },
    { "src": "/",                "dest": "/okay-dev-vanilla/index.html" },
    { "src": "/(.*)",            "dest": "/okay-dev-vanilla/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
