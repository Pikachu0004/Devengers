# ========================================================
# Devengers Email & SMTP Configuration
# ========================================================
# For Gmail:
# DEVENGERS_SMTP_HOST=smtp.gmail.com
# DEVENGERS_SMTP_PORT=587
# DEVENGERS_SMTP_USER=your_email@gmail.com
# DEVENGERS_SMTP_PASSWORD=your_16_char_google_app_password
# DEVENGERS_FROM_EMAIL=support@devengers.org
#
# For Custom Domain / Google Workspace / Hostinger / Zoho:
# DEVENGERS_SMTP_HOST=smtp.zoho.com  # or smtp.hostinger.com or smtp.gmail.com
# DEVENGERS_SMTP_PORT=587
# DEVENGERS_SMTP_USER=support@devengers.org
# DEVENGERS_SMTP_PASSWORD=your_mailbox_password
# DEVENGERS_FROM_EMAIL=support@devengers.org
# ========================================================

DEVENGERS_SMTP_HOST=
DEVENGERS_SMTP_PORT=587
DEVENGERS_SMTP_USER=
DEVENGERS_SMTP_PASSWORD=
DEVENGERS_FROM_EMAIL=support@devengers.org
DEVENGERS_DEV_MODE=false

# Optional: Google OAuth 2.0 Web Client ID (from console.cloud.google.com)
DEVENGERS_GOOGLE_CLIENT_ID=
